<div class="dataset-dependent" data-dataset="imdb">
    <div class="box" id="result-display">
        <h2>Query Results</h2>
        <div id="result-display-form" class="floater" style="display: none;">
            <input type="checkbox" id="toggle-original-query"  data-rewrite-id="original" data-query-id="original" onclick="toggleQueryVisibility('original', 'original')" checked>
            <label for="toggle-original-query">Show Original Query Result</label>
        </div>
        <div class="content row" id="result-list"></div>
    </div>
</div>