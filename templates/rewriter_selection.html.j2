<div id="rewriter" class="box">
    <h2>Configure Rewriter</h2>
    <form class="content">
        <div class="row" id="rewriter-components">
            <div>
                Table Filter:<br>
                <select name="table-filter" id="table-filter">
                    <option value="1">Embedding Filter</option>
                    <option value="2">Simple LLM Filter</option>
                    <option value="3" selected>Complex LLM Filter</option>
                    <option value="-1">None</option>
                </select>
            </div>
            <div>
                Rewriter:<br>
                <select name="rewriter" id="rewriter">
                    <option value="1">Simple Rewriter</option>
                    <option value="2" selected>Natural Language Rewriter</option>
                </select>
            </div>
            <div>
                Ranker:<br>
                <select name="ranker" id="ranker">
                    <option value="2" selected>Intent-based</option>
                    <option value="3">MMR</option>
                    <option value="-1">None</option>
                </select>
            </div>
            <div>
                Intent-Similarity:<br>
                <select name="similarity" id="similarity">
                    <option value="1">Embedding</option>
                    <option value="2" selected>LLM</option>
                </select>
            </div>
            <button type="button" id="run-rewriter" class="button" onclick="run_rewriter()"> Run &rarr;</button>
        </div>
        <input type="checkbox" id="show-advanced-rewriter-options" class="expander">
        <label for="show-advanced-rewriter-options">Show Advanced Options</label>
        <div class="row" id="rewriter-details">
            <div>
                GPT Model<br>
                <select name="gpt-model" id="gpt-model">
                    {% for model in defaults.supported_models %}
                    <option value="{{ model.key }}" {% if model.key == defaults.default_model_key %}selected{% endif %}>{{ model.name }}</option>
                    {% endfor %}
                </select>
            </div>
            <div>
                <label for="alternative-query-count">#Alternative Queries</label>
                <input type="number" id="alternative-query-count" name="alternative-query-count" value="{{ defaults['alternative_query_count'] }}" min="1">
            </div>
            <div>
                <label for="additional-query-count">#Additional Queries</label>
                <input type="number" id="additional-query-count" name="additional-query-count" value="{{ defaults['additional_query_count'] }}" min="0">
            </div>
            <div>
                <label for="embedding-threshold">ES Threshold</label>
                <input type="number" id="embedding-threshold" name="embedding-threshold" value="{{ defaults['embedding_threshold'] }}" min="0" max="1" step=".1">
            </div>
            <div>
                <label for="sllm-expected-selectivity">SLLM Selectivity</label>
                <input type="number" id="sllm-expected-selectivity" name="sllm-expected-selectivity" value="{{ defaults['sllm_expected_selectivity'] }}" min="0" max="1" step=".1">
            </div>
            <div>
                <label for="cllm-threshold">CLLM Threshold</label>
                <input type="number" id="cllm-threshold" name="cllm-threshold" value="{{ defaults['cllm_threshold'] }}" min="0" max="1" step=".1">
            </div>
            <div>
                <label for="mmr-lambda">MMR Lambda</label>
                <input type="number" id="mmr-lambda" name="mmr-lambda" value="{{ defaults['mmr_lambda'] }}" min="0" max="1" step=".1">
            </div>
            <div>
                <label for="lmms-package-size">LMMS Package Size</label>
                <input type="number" id="lmms-package-size" name="lmms-package-size" value="{{ defaults['lmms_package_size'] }}" min="1">
            </div>
            <div>
                <label for="correction-tries">#Correction Tries</label>
                <input type="number" id="correction-tries" name="correction-tries" value="{{ defaults['correction_tries'] }}" min="0">
            </div>
        </div>
    </form>
</div>
<span id="rewrite-marker"></span>
